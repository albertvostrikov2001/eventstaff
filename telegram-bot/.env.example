TELEGRAM_BOT_TOKEN=
# Public API and public website. Both must point to the same environment.
UNITY_API_URL=https://unityevent.ru/api/v1
UNITY_SITE_URL=https://unityevent.ru
# Absolute persistent directory recommended on the server.
TELEGRAM_STATE_DIR=./telegram-bot/data
# Optional fallback if Node HTTPS times out on the VPS. Requires installed curl.
# TELEGRAM_TRANSPORT=curl
# Optional verified Telegram IPv4 if the DNS-provided address is unreachable.
# TELEGRAM_API_IPV4=
# Bot-only HTTPS/SOCKS proxy; its credentials stay in this private file.
# TELEGRAM_PROXY_URL=socks5h://user:password@proxy-host:1080
# Optional direct-connection workaround: HEAD, then Bot API on the same TLS session.
# TELEGRAM_WARMUP=1
